{
  "$schema": "https://tr.designtokens.org/format/",
  "meta": {
    "product": "THREADFLOW — Fashion Supply Chain & Merchandising Control Tower",
    "version": "2.4.0",
    "theme": "Enterprise Warm Stone & Charcoal"
  },
  "color": {
    "canvas": {
      "primary": { "$value": "#F6F5F2", "$type": "color" },
      "secondary": { "$value": "#EFECE6", "$type": "color" },
      "surface": { "$value": "#FFFFFF", "$type": "color" },
      "rail": { "$value": "#18181B", "$type": "color" },
      "border": { "$value": "#D6D3CD", "$type": "color" }
    },
    "ink": {
      "primary": { "$value": "#18181B", "$type": "color" },
      "secondary": { "$value": "#3F3F46", "$type": "color" },
      "muted": { "$value": "#71717A", "$type": "color" },
      "inverse": { "$value": "#F4F4F5", "$type": "color" }
    },
    "status": {
      "healthy": { "text": "#166534", "bg": "#DCFCE7", "border": "#86EFAC" },
      "active": { "text": "#1E3A8A", "bg": "#DBEAFE", "border": "#93C5FD" },
      "warning": { "text": "#9A3412", "bg": "#FFEDD5", "border": "#FDBA74" },
      "critical": { "text": "#991B1B", "bg": "#FEE2E2", "border": "#FCA5A5" }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "Inter, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
      "mono": "JetBrains Mono, Consolas, monospace"
    },
    "scale": {
      "pageTitle": { "size": "18px", "lineHeight": "24px", "weight": 600 },
      "sectionHeader": { "size": "14px", "lineHeight": "20px", "weight": 600 },
      "tableHeader": { "size": "11px", "lineHeight": "16px", "weight": 600, "tracking": "0.05em" },
      "tableCell": { "size": "13px", "lineHeight": "18px", "weight": 400 },
      "monoMetric": { "size": "12px", "lineHeight": "16px", "weight": 500 }
    }
  },
  "spacing": {
    "railWidth": "240px",
    "topBarHeight": "48px",
    "tableRowHeight": "40px",
    "borderRadius": "2px"
  }
}
