# =============================================================================
# THREADFLOW — Fashion Supply Chain & Merchandising Control Tower
# Environment Configuration Template (No hardcoded secrets)
# =============================================================================

# 1. Database Connection
# Production PostgreSQL:
# DATABASE_URL=postgresql+psycopg://threadflow_user:change_me@localhost:5432/threadflow
# Local Zero-Config Fallback (SQLite with strict foreign keys & PostgreSQL DDL compatibility):
DATABASE_URL=sqlite:///./threadflow.db

# 2. Product Analytics (Mixpanel)
# Leave blank to use the local PostgreSQL/SQLite analytics_events adapter
MIXPANEL_TOKEN=

# 3. GenAI Operations Assistant (Google Gemini API)
# Uses google-genai SDK with gemini-4-hydrogen when set; uses deterministic SQL-evidence engine when blank
GEMINI_API_KEY=

# 4. Frontend -> Backend API Routing (Vercel / Next.js)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# 5. Optional Enterprise BI & Product Ops Connectors
TABLEAU_SERVER_URL=
JIRA_BASE_URL=
FIGMA_ACCESS_TOKEN=
